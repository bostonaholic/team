{
  "$comment": "Agent and phase-artifact inventory. The team coordinator dispatches the hidden team-* phase modules; phase-state.mjs resolves completion. Agent names remain synchronized with agents/*.md by .claude/hooks/check-registry-sync.mjs.",
  "phases": [
    {"name": "WORKTREE", "artifacts": ["1-task.md"]},
    {"name": "QUESTION", "artifacts": ["2-questions.md"]},
    {"name": "RESEARCH", "artifacts": ["5-research.md"]},
    {"name": "DESIGN", "artifacts": ["6-design.md", "design-review-<n>.md"]},
    {"name": "STRUCTURE", "artifacts": ["7-structure.md"]},
    {"name": "PLAN", "artifacts": ["8-plan.md"]},
    {"name": "IMPLEMENT", "artifacts": ["9-implementation.md"]},
    {"name": "PR", "artifacts": ["10-pr.md"]}
  ],
  "agents": [
    {"name": "questioner", "phase": "QUESTION"},
    {"name": "file-finder", "phase": "RESEARCH", "parallel": true},
    {"name": "researcher", "phase": "RESEARCH", "parallel": true},
    {"name": "design-author", "phase": "DESIGN"},
    {"name": "structure-planner", "phase": "STRUCTURE"},
    {"name": "planner", "phase": "PLAN"},
    {"name": "test-architect", "phase": "IMPLEMENT"},
    {"name": "implementer", "phase": "IMPLEMENT"},
    {"name": "code-reviewer", "phase": "IMPLEMENT", "parallel": true},
    {"name": "security-reviewer", "phase": "IMPLEMENT", "parallel": true},
    {"name": "technical-writer", "phase": "IMPLEMENT", "parallel": true},
    {"name": "ux-reviewer", "phase": "IMPLEMENT", "parallel": true},
    {"name": "verifier", "phase": "IMPLEMENT", "parallel": true}
  ],
  "gates": [
    {"before": "QUESTION", "type": "orchestrator-emit", "action": "prepare home worktree on branch <id> and author docs/plans/<id>/ inside it"},
    {"after": "DESIGN", "type": "review", "artifact": "design-review-<n>.md"},
    {"after": "DESIGN", "type": "orchestrator-emit", "action": "prepare secondary worktrees per 4-repos.md and back-record ## Worktrees (multi-repo only)"},
    {"after": "test-architect", "type": "mechanical", "condition": "all tests fail with assertion errors, not crashes"},
    {"after": "5 reviewers", "type": "aggregate", "hardGates": ["security-reviewer", "verifier", "code-reviewer"]}
  ]
}
