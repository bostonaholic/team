# Claude worktrees
.claude/worktrees/

# dev CLI
.dev/

# Team pipeline state
.team/

# Pipeline artifacts — per-run scratch, and excluded from the docs site
docs/plans/

# Beads / Dolt files (added by bd init)
# NOTE: do NOT add a blanket `.beads/` ignore — bd's own .beads/.gitignore
# tracks issues.jsonl + config while ignoring the Dolt runtime. Ignoring all of
# .beads/ breaks bd's JSONL auto-export (its `git add` fails). The credential
# key and *.db files stay ignored via the patterns below.
.dolt/
*.db
.beads-credential-key

# Playwright
.playwright-mcp/

# Jekyll site build artifacts
# regenerated from the live Releases API on every build
docs/rss.xml
docs/_site/
docs/.jekyll-cache/
docs/.sass-cache/
docs/.jekyll-metadata
docs/.bundle/
docs/vendor/

# Stray Bundler installs at repo root (gems should go in docs/vendor/bundle/)
/vendor/

# Eval run results (generated locally; CI uploads them as artifacts)
evals/results/

# Local secrets (repo-root .env holds API keys)
.env
.env.*

# Bun / npm dependencies
node_modules/
