#!/usr/bin/env bash
set -euo pipefail

# Dev install, across the harnesses Team supports.
#
#   script/dev-install          every harness
#   script/dev-install codex    just that one
#
# Each harness has its own script beside this one, because each host installs
# a plugin its own way. Adding a harness means adding `dev-install-<name>` and
# `dev-uninstall-<name>`, then listing it below.

HARNESSES=(claude codex)
HERE="$(cd "$(dirname "$0")" && pwd)"

case "${1:-}" in
  "")
    targets=("${HARNESSES[@]}")
    ;;
  *)
    for known in "${HARNESSES[@]}"; do
      [ "$1" = "$known" ] && targets=("$1") && break
    done
    if [ -z "${targets+x}" ]; then
      echo "Error: unknown harness '$1'. Known: ${HARNESSES[*]}" >&2
      exit 1
    fi
    ;;
esac

failed=()
for harness in "${targets[@]}"; do
  # One harness failing must not strand the others — report at the end.
  if ! "${HERE}/dev-install-${harness}"; then
    failed+=("$harness")
  fi
  echo
done

if [ ${#failed[@]} -gt 0 ]; then
  echo "Error: install failed for: ${failed[*]}" >&2
  exit 1
fi
