#!/usr/bin/env bash
set -euo pipefail

# Mirrors script/dev-uninstall for Codex CLI.
#
# Removes the native plugin install, the marketplace registration, and the
# cached plugin tree, plus the collection symlink an earlier version of
# script/dev-install-codex left at ~/.agents/skills/team. The goal is that
# nothing Team wrote survives: no cache directory, no marketplace row, no
# dangling link.
#
# Each install mints a new cachebuster version, so the cache can hold more than
# one directory if a run was interrupted before it pruned. Removing the
# marketplace root sweeps all of them at once.
#
# Every removal here unlinks rather than descends: an earlier dev install could
# have left a symlink into a checkout under the cache, and `rm -rf` on a
# symlink removes the link, never the target.
#
# The legacy link's parents can be user-owned — ~/.agents/skills is often a
# dotfiles checkout — so unlike script/dev-uninstall, which owns its whole
# cache path, this one never removes a parent it did not create.

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LEGACY_LINK="${HOME}/.agents/skills/team"
MARKETPLACE="team-dev"
PLUGIN="team"
CACHE_ROOT="${HOME}/.codex/plugins/cache/${MARKETPLACE}"

echo "Uninstalling Team for Codex (dev)..."
echo

REMOVED_SOMETHING=false

# --- The legacy collection symlink -------------------------------------------
if [ -L "$LEGACY_LINK" ]; then
  LINKED_TO="$(readlink "$LEGACY_LINK")"
  rm "$LEGACY_LINK"
  echo "  Removed the legacy skill link: ${LEGACY_LINK} → ${LINKED_TO}"
  REMOVED_SOMETHING=true
elif [ -e "$LEGACY_LINK" ]; then
  echo "Error: ${LEGACY_LINK} is not a symlink — this script did not create it." >&2
  echo "Nothing was removed. Move it by hand if you meant to." >&2
  exit 1
fi

# --- The native plugin install -----------------------------------------------
if command -v codex >/dev/null 2>&1; then
  # shellcheck disable=SC2016
  INSTALLED=$(
    codex plugin list --json |
      PLUGIN_ID="${PLUGIN}@${MARKETPLACE}" node -e '
        const parsed = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
        const list = Array.isArray(parsed) ? parsed : (parsed.installed ?? []);
        if (list.some((entry) => entry.pluginId === process.env.PLUGIN_ID && entry.installed)) {
          process.stdout.write("yes");
        }
      '
  )
  if [ -n "$INSTALLED" ]; then
    codex plugin remove "${PLUGIN}@${MARKETPLACE}" 2>&1
    REMOVED_SOMETHING=true
  fi

  # shellcheck disable=SC2016
  REGISTERED=$(
    codex plugin marketplace list --json |
      MARKETPLACE="$MARKETPLACE" node -e '
        const entries = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
        const list = Array.isArray(entries) ? entries : (entries.marketplaces ?? []);
        const match = list.find((entry) => entry.name === process.env.MARKETPLACE);
        if (match) process.stdout.write(String(match.root ?? ""));
      '
  )
  if [ -n "$REGISTERED" ]; then
    if [ "$REGISTERED" != "$PLUGIN_ROOT" ]; then
      echo "  Note: the ${MARKETPLACE} marketplace points at another checkout:"
      echo "    ${REGISTERED}"
    fi
    codex plugin marketplace remove "$MARKETPLACE" 2>&1
    REMOVED_SOMETHING=true
  fi
else
  echo "  Note: the codex CLI is not on PATH. Removing Team's files only."
fi

# --- Whatever the CLI left behind --------------------------------------------
# `codex plugin remove` empties the version directories but keeps the
# marketplace directory above them, so sweep the tree Team owns outright.
if [ -e "$CACHE_ROOT" ] || [ -L "$CACHE_ROOT" ]; then
  rm -rf "$CACHE_ROOT"
  echo "  Removed the plugin cache: ${CACHE_ROOT}"
  REMOVED_SOMETHING=true
fi

if [ "$REMOVED_SOMETHING" = false ]; then
  echo "  Nothing to do: Team is not installed for Codex."
  exit 0
fi

echo
echo "Uninstalled Team for Codex (dev). Codex drops the skills at the next thread start."
