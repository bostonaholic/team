#!/usr/bin/env bash
set -euo pipefail

# Mirrors script/dev-uninstall for Antigravity CLI.
#
# Removes only the symlink script/dev-install-antigravity created. A native
# `agy plugin install` writes a real directory at the same path, so anything that
# is not a symlink is left alone and named — `agy plugin uninstall team` owns
# that one. The parent is the host's own config tree and is never removed.

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TARGET="${HOME}/.gemini/config/plugins/team"

echo "Uninstalling Team for Antigravity (dev)..."
echo

if [ ! -L "$TARGET" ] && [ ! -e "$TARGET" ]; then
  echo "  Nothing to do: ${TARGET} does not exist."
  exit 0
fi

if [ ! -L "$TARGET" ]; then
  echo "Error: ${TARGET} is not a symlink — this script did not create it." >&2
  echo "It looks like a native install. Remove it with: agy plugin uninstall team" >&2
  echo "Nothing was removed." >&2
  exit 1
fi

LINKED_TO="$(readlink "$TARGET")"
rm "$TARGET"
echo "  Removed: ${TARGET} → ${LINKED_TO}"
if [ "$LINKED_TO" != "$PLUGIN_ROOT" ]; then
  echo "  Note: that link pointed at another checkout, not ${PLUGIN_ROOT}."
fi

echo
echo "Done. Antigravity drops the skills and agents at the next session start."
