#!/usr/bin/env bash
set -euo pipefail

# Mirrors script/dev-install for Antigravity CLI (`agy`). Links one symlink per
# user-invocable, unguarded skill into this host's global skill scope, so an
# edit to a SKILL.md is live in the next session. Each run reconciles the whole
# set rather than only adding to it: a skill that stops being installable loses
# the link an earlier run gave it, so no developer action stands between a
# filter change and the state on disk.
#
# The catalog name comes from each skill's frontmatter `name:`, never from the
# link name, so this host gives Team no namespace at all: `shipit`, not
# `team:shipit`. Team's bare names therefore share one flat directory with the
# user's own skills. That is why every target path is read before anything is
# written, and why the uninstall selects by link target rather than by name.
#
# Team's own pipeline works in .claude/worktrees/<topic>/, so a checkout and
# one of its worktrees are two checkouts competing for the same names.
# Installing from one and re-running from the other aborts by design; the abort
# names the checkout that owns the links, and running
# `script/dev-uninstall antigravity` from there clears them.
#
# This host's global *plugin* root — the cache `agy plugin import` owns — is
# out of reach on purpose, and no path below names it. Writing there would put
# Team's skills under two roots with no namespace to tell them apart, and
# reading it is out of scope: a name collision under that root is one of the
# cases README.md documents as undetectable.
#
# macOS ships bash 3.2, which has no `readlink -f`, no `realpath`, and no
# `mapfile`. Paths resolve with `cd` + `pwd -P` on both sides of every
# comparison, so a symlinked path component cannot make an ownership test lie.

PLUGIN_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
SKILLS_SRC="${PLUGIN_ROOT}/skills"
TARGET_DIR="${HOME}/.gemini/config/skills"

if [ ! -d "$SKILLS_SRC" ]; then
  echo "Error: no skills/ directory at ${PLUGIN_ROOT}" >&2
  exit 1
fi

SKILLS_PHYS="$(cd "$SKILLS_SRC" && pwd -P)"

# Read one top-level key out of the leading `---` block of a file. Both keys
# this script filters on also appear in skill bodies and in README prose, so a
# whole-file grep misclassifies.
#
# Prints the raw value and exits 0 when the key is inside that block, exits 1
# when the block is there without the key, exits 2 when the file has no leading
# `---` block at all, and exits 3 when that block's own keys are indented. Pass
# 3 treats each of those differently.
#
# A key is read at column 0 only. YAML permits an indented root mapping, so
# ` disable-model-invocation: true` sets the guard while sitting one space in,
# and a reader that called the key absent there would fail open on the one key
# whose absence installs a skill. Widening the match to any indentation is worse
# than the hole it closes: the continuation lines of a block scalar are indented
# too, so `description: |` prose that merely mentions a key would start filtering
# skills on words. So the *shape* is rejected instead of guessed at. The block's
# first non-blank line decides: indented there means an indented root mapping,
# and this reader interprets none of it.
frontmatter_value() {
  awk -v key="$1" '
    NR == 1 { if ($0 != "---") { noblock = 1; exit } ; next }
    $0 == "---" { exit }
    !seen && $0 ~ /^[ \t]*$/ { next }
    !seen {
      seen = 1
      if ($0 ~ /^[ \t]/) { indented = 1; exit }
    }
    index($0, key ":") == 1 {
      value = substr($0, length(key) + 2)
      sub(/^[ \t]+/, "", value)
      sub(/[ \t]+$/, "", value)
      print value
      found = 1
      exit
    }
    END {
      if (noblock || NR == 0) exit 2
      if (indented) exit 3
      if (!found) exit 1
    }
  ' "$2"
}

# A symlink's target as an absolute path, joining a relative link text onto the
# directory that holds the link. The target need not exist.
link_target_path() {
  local link_text
  link_text="$(readlink "$1")"
  case "$link_text" in
    /*) printf '%s\n' "$link_text" ;;
    *) printf '%s\n' "$(dirname "$1")/${link_text}" ;;
  esac
}

# The physical directory holding a target path, or "" when that directory is
# itself gone. Canonicalizing the *parent* rather than the target is what keeps
# a link whose leaf has been deleted attributable to the checkout that made it.
link_target_parent() {
  (cd "$(dirname "$1")" 2>/dev/null && pwd -P) || printf '%s' ""
}

# The lexical parent named by a symlink's own text, used when that directory no
# longer exists so nothing can be canonicalized. Absolute text names its
# directory outright, so a link still says which checkout wrote it after that
# checkout's skills/ is gone. Relative text yields "" instead: reducing it needs
# the very directory that went missing, and guessing at ownership on a path
# under $HOME is worse than one printed line.
link_text_parent() {
  local link_text
  link_text="$(readlink "$1")"
  case "$link_text" in
    /*) dirname "$link_text" ;;
    *) printf '%s' "" ;;
  esac
}

# The directory a symlink is attributable to, resolved where it still exists and
# lexical where it does not. "" means no checkout can claim the link.
link_owner_dir() {
  local owner
  owner="$(link_target_parent "$(link_target_path "$1")")"
  [ -n "$owner" ] || owner="$(link_text_parent "$1")"
  printf '%s\n' "$owner"
}

# Is the path in $1 this checkout's own link for the skill named in $2? This is
# the single ownership question the whole script turns on: the pre-check treats
# such a path as free to write, the reconciliation treats it as this checkout's
# to remove, and the collision scan skips it. It is also the uninstall's sweep
# criterion read forward, which is what keeps the two scripts agreeing.
owns_link() {
  [ -L "$1" ] || return 1
  [ "$(link_owner_dir "$1")" = "$SKILLS_PHYS" ] || return 1
  [ "$(basename "$(link_target_path "$1")")" = "$2" ]
}

# Pass 1: every direct child of skills/ that owns a SKILL.md. A directory
# without one is not a skill, and is not an error either.
candidates=()
for entry in "$SKILLS_SRC"/*; do
  [ -d "$entry" ] || continue
  [ -f "${entry}/SKILL.md" ] || continue
  candidates+=("$(basename "$entry")")
done

if [ ${#candidates[@]} -eq 0 ]; then
  echo "Error: no skill directory under ${SKILLS_SRC} owns a SKILL.md" >&2
  exit 1
fi

# Pass 2: drop `user-invocable: false`. Those are the methodology skills an
# agent loads — this key defines that set here, not the argument-hint count
# docs/skills.md uses — and this install links no agents, so they serve nobody
# on this host. A value this cannot read fails open: the worst case is one extra
# catalog entry, not a hazardous skill, so only pass 3 aborts.
#
# `excluded` collects the bare name behind every skip, in both passes. A skip is
# not only something to print: a name this run rejects may still hold a link an
# earlier run wrote, and the reconciliation below is what takes it away.
invocable=()
skipped=()
excluded=()
for name in "${candidates[@]}"; do
  file="${SKILLS_SRC}/${name}/SKILL.md"
  value=""
  status=0
  value="$(frontmatter_value user-invocable "$file")" || status=$?
  if [ "$status" -eq 0 ] && [ "$value" = "false" ]; then
    skipped+=("${name} (user-invocable: false)")
    excluded+=("$name")
  else
    invocable+=("$name")
  fi
done

# Pass 3: `disable-model-invocation`. `true` holds a skill back, `false` and an
# absent key install it, and anything else — an unreadable value, or a
# frontmatter shape the reader above will not interpret — stops the whole run
# with the file named. A quoted `"true"` read as a plain string, or an indented
# key read as no key, would each install the very skill the guard holds back.
# Pass-2 survivors only: a file that can never become a link can never be the
# hazard.
#
# Three shapes reach this abort and each needs a different edit, so the remedy
# travels with its own diagnosis in `unreadable_fix` rather than as one trailer
# under all of them: a file with no frontmatter block has no key to unquote, and
# an indented block stays indented after its value is fixed. Keeping the pair
# parallel by index also keeps the report in file order, so a run over several
# broken files reads top to bottom.
survivors=()
guarded=()
unreadable=()
unreadable_fix=()
if [ ${#invocable[@]} -gt 0 ]; then
  for name in "${invocable[@]}"; do
    file="${SKILLS_SRC}/${name}/SKILL.md"
    value=""
    status=0
    value="$(frontmatter_value disable-model-invocation "$file")" || status=$?
    if [ "$status" -eq 2 ]; then
      unreadable+=("${file}: no leading --- frontmatter block")
      unreadable_fix+=("add a --- line as the file's first line, and a closing --- after the keys")
    elif [ "$status" -eq 3 ]; then
      unreadable+=("${file}: the frontmatter block's keys are indented, so no top-level key can be read")
      unreadable_fix+=("move every key in that block to column 0")
    elif [ "$status" -eq 1 ]; then
      survivors+=("$name")
    elif [ "$value" = "true" ]; then
      guarded+=("$name")
      skipped+=("${name} (disable-model-invocation: true)")
      excluded+=("$name")
    elif [ "$value" = "false" ]; then
      survivors+=("$name")
    else
      unreadable+=("${file}: disable-model-invocation: ${value}")
      unreadable_fix+=("give the key an unquoted true or false")
    fi
  done
fi

if [ ${#unreadable[@]} -gt 0 ]; then
  echo "Error: a disable-model-invocation value could not be read, so no link was written:" >&2
  index=0
  while [ "$index" -lt ${#unreadable[@]} ]; do
    echo "  ${unreadable[$index]}" >&2
    echo "    Fix: ${unreadable_fix[$index]}, then re-run." >&2
    index=$((index + 1))
  done
  exit 1
fi

if [ ${#survivors[@]} -eq 0 ]; then
  # A zero-link success would read as an install that worked.
  echo "Error: every skill under ${SKILLS_SRC} was filtered out, so there is nothing to install." >&2
  exit 1
fi

# Refuse to stack this on a native plugin install of Team. This host applies no
# namespace, so the same skills reached through two roots shadow each other
# instead of erroring, and a doubled catalog is a silent failure. A
# registered-but-uninstalled row reads `not installed` and is fine; only an
# installed row collides. Nothing supported can install Team as an `agy` plugin
# today, so this is a backstop against a hand-made plugin root. An absent or
# erroring `agy` is not a reason to stop: a dev install must work before the
# host is installed.
if command -v agy >/dev/null 2>&1; then
  plugin_list="$(agy plugin list 2>&1)" || plugin_list=""
  while IFS= read -r line; do
    case "$line" in
      *team@*)
        case "$line" in
          *"not installed"*) ;;
          *)
            echo "Error: an Antigravity plugin install of Team is already present:" >&2
            echo "  ${line}" >&2
            echo "Adding these symlinks too would load every skill twice." >&2
            echo "Remove one first, e.g. agy plugin remove team@<marketplace>" >&2
            exit 1
            ;;
        esac
        ;;
    esac
  done <<<"$plugin_list"
fi

# Every target path is read before anything is written, and one path this
# checkout does not own aborts the whole run. A partial install is worse than
# none, and a clobbered link could never be restored: the uninstall selects by
# link target, so the target it would need is exactly what got overwritten.
blocked=()
orphaned=0
for name in "${survivors[@]}"; do
  path="${TARGET_DIR}/${name}"
  if [ -L "$path" ]; then
    text="$(readlink "$path")"
    leaf="$(basename "$(link_target_path "$path")")"
    parent="$(link_owner_dir "$path")"
    if owns_link "$path" "$name"; then
      : # Already this checkout's own link, so the write below is a no-op.
    elif [ "$parent" = "$SKILLS_PHYS" ]; then
      blocked+=("${path} -> ${text} (a link into this checkout's skills/, but to ${leaf} rather than ${name})")
    elif [ -z "$parent" ]; then
      orphaned=1
      blocked+=("${path} -> ${text} (a relative link whose directory is gone, so no checkout can claim it)")
    elif [ -d "$parent" ]; then
      blocked+=("${path} -> ${text} (a symlink into a directory outside this checkout)")
    else
      orphaned=1
      blocked+=("${path} -> ${text} (a symlink into ${parent}, which no longer exists)")
    fi
  elif [ -d "$path" ]; then
    blocked+=("${path} (a directory)")
  elif [ -e "$path" ]; then
    blocked+=("${path} (a regular file)")
  fi
done

# A guarded name is read too, for the opposite question: not whether this run may
# write there, but whether it can take away what is already there. The
# reconciliation below removes only this checkout's own link, so a link another
# checkout wrote before the guard existed would survive every run of this script
# and keep a model-invocable skill live in every session — the exact state the
# guard exists to prevent, on a host with no trust gate to fall back on. Team's
# pipeline works inside .claude/worktrees/, so two checkouts racing for one name
# is the ordinary case here, not a contrived one.
#
# Only a live symlink counts. A dangling one loads nothing, and a directory is
# content no install of this script could have written, so neither is a guarded
# skill this run left reachable. The end-of-run note reports both.
guarded_kept_live=()
if [ ${#guarded[@]} -gt 0 ]; then
  for name in "${guarded[@]}"; do
    path="${TARGET_DIR}/${name}"
    [ -L "$path" ] || continue
    owns_link "$path" "$name" && continue
    [ -f "${path}/SKILL.md" ] || continue
    guarded_kept_live+=("${path} -> $(readlink "$path") (a symlink this checkout cannot remove, so ${name} loads in every session)")
  done
fi

if [ ${#blocked[@]} -gt 0 ] || [ ${#guarded_kept_live[@]} -gt 0 ]; then
  if [ ${#blocked[@]} -gt 0 ]; then
    echo "Error: these target paths are not this checkout's to write, so nothing was created:" >&2
    for line in "${blocked[@]}"; do
      echo "  ${line}" >&2
    done
  fi
  if [ ${#guarded_kept_live[@]} -gt 0 ]; then
    echo "Error: these skills set disable-model-invocation, but a link this checkout does not own keeps them installed:" >&2
    for line in "${guarded_kept_live[@]}"; do
      echo "  ${line}" >&2
    done
  fi
  # A link at a *guarded* name need not point into a checkout of Team at all —
  # any hand-made link to a live skill directory reaches this abort — so the
  # uninstall clause is stated as the conditional it is. The second clause always
  # applies, and is what a reader falls back to.
  echo "Where a link resolves into another checkout of Team, run" >&2
  echo "'script/dev-uninstall antigravity' from that checkout. Otherwise move what" >&2
  echo "sits at the path out of the way. Then re-run." >&2
  if [ "$orphaned" -eq 1 ]; then
    echo "A link whose own directory is gone has no checkout left to run that from," >&2
    echo "so removing that link is the only way to clear its path." >&2
  fi
  exit 1
fi

# The install converges rather than only adds. A skill that has *become*
# uninstallable since the last run still holds this checkout's link, and nothing
# else on this host would ever take it away. The guarded set is what makes this a
# safety matter rather than tidiness: this host has no trust gate, so a link left
# behind keeps a model-invocable skill live in every session, and the note this
# script prints at the end would be describing a skill that is installed.
#
# Only a name still on disk can be reconciled here, because this loop iterates
# the names the passes above rejected. A renamed or deleted skill leaves no such
# name, so its orphan link stays the uninstall's job — that sweep selects by
# where a link points and so needs no current name at all.
stale=()
if [ ${#excluded[@]} -gt 0 ]; then
  for name in "${excluded[@]}"; do
    owns_link "${TARGET_DIR}/${name}" "$name" || continue
    stale+=("$name")
  done
fi

echo "Installing Team skills for Antigravity (dev)..."
echo "  Source: ${SKILLS_SRC}"
echo "  Target: ${TARGET_DIR}"
echo

# The catalog names Team is about to claim, parallel to `survivors` by index.
# A name comes from frontmatter, never from the directory, so the two lists can
# differ and the collision scan below needs both.
survivor_names=()
for name in "${survivors[@]}"; do
  value=""
  status=0
  value="$(frontmatter_value name "${SKILLS_SRC}/${name}/SKILL.md")" || status=$?
  [ "$status" -eq 0 ] || value=""
  survivor_names+=("$value")
done

# Warn when a sibling entry already claims one of those names. A directory named
# `my-ship/` carrying `name: shipit` shadows Team's shipit silently, because the
# host resolves a duplicate name by precedence rather than reporting it. This
# only warns: Team's link is still created, and which one wins is the host's
# call. Entries this checkout already owns are skipped, or a re-run would report
# every one of Team's own links as a collision, each name matching by
# construction.
if [ -d "$TARGET_DIR" ]; then
  for entry in "$TARGET_DIR"/*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue

    if [ -L "$entry" ]; then
      [ "$(link_owner_dir "$entry")" != "$SKILLS_PHYS" ] || continue
    fi

    sibling_file="${entry}/SKILL.md"
    [ -f "$sibling_file" ] || continue

    # A sibling with no SKILL.md is not a skill. One with no `name:` takes its
    # folder name on this host, and a folder named like one of Team's links was
    # already refused above as an occupied path — so what is left can only
    # shadow a Team skill whose catalog name matches its own directory name,
    # which every skill in this corpus does.
    sibling_name=""
    status=0
    sibling_name="$(frontmatter_value name "$sibling_file")" || status=$?
    if [ "$status" -ne 0 ] || [ -z "$sibling_name" ]; then
      continue
    fi

    index=0
    while [ "$index" -lt ${#survivors[@]} ]; do
      if [ -n "${survivor_names[$index]}" ] &&
        [ "${survivor_names[$index]}" = "$sibling_name" ]; then
        echo "  Warning: ${entry} already claims the catalog name '${sibling_name}', which Team's ${survivors[$index]} skill also uses."
        echo "           Antigravity picks one by precedence, so the other will not be reachable."
      fi
      index=$((index + 1))
    done
  done
fi

mkdir -p "$TARGET_DIR"

# Reconcile before linking, so a name that changed sides is gone from the
# directory before the current set is written into it.
removed=0
if [ ${#stale[@]} -gt 0 ]; then
  for name in "${stale[@]}"; do
    rm "${TARGET_DIR}/${name}"
    echo "  Removed: ${TARGET_DIR}/${name} (this checkout's link to a skill that no longer installs here)"
    removed=$((removed + 1))
  done
fi

created=0
already=0
for name in "${survivors[@]}"; do
  path="${TARGET_DIR}/${name}"
  # The pre-check aborted on every symlink at a survivor path except this
  # checkout's own, so a link still standing here is already the one to write.
  # Counting the two cases apart is what tells a no-op re-run from real work.
  # Asking the ownership question again rather than testing for a symlink is what
  # keeps a link swapped in since that check from being counted as work already
  # done; the write below then puts the right link there. The window between the
  # two reads cannot be closed, and stays accepted.
  if owns_link "$path" "$name"; then
    already=$((already + 1))
    continue
  fi
  ln -sfn "${SKILLS_SRC}/${name}" "$path"
  echo "  Linked: ${path} -> ${SKILLS_SRC}/${name}"
  created=$((created + 1))
done

if [ ${#skipped[@]} -gt 0 ]; then
  echo
  for line in "${skipped[@]}"; do
    echo "  Skipped: ${line}"
  done
fi

summary="${created} newly linked, ${already} already linked"
[ "$removed" -eq 0 ] || summary="${summary}, ${removed} removed"
echo
echo "  ${summary}, ${#skipped[@]} skipped, of ${#candidates[@]} skills on disk."

# Every line below reports what is on disk after this run, never what this run
# meant to do. A note that stated intent could say a skill is not installed while
# a link to it sits right there, which is the one thing this note must never do.
if [ ${#guarded[@]} -gt 0 ]; then
  echo "  Note: Antigravity has no trust gate and no activation prompt, so every"
  echo "        installed skill is model-invocable in every session. These set"
  echo "        disable-model-invocation, so this install links none of them."
  echo "        What each one's path holds now:"
  for name in "${guarded[@]}"; do
    path="${TARGET_DIR}/${name}"
    if [ -L "$path" ]; then
      echo "          ${name} — ${path} is a symlink to $(readlink "$path")"
    elif [ -d "$path" ]; then
      echo "          ${name} — ${path} is a directory"
    elif [ -e "$path" ]; then
      echo "          ${name} — ${path} is a file"
    else
      echo "          ${name} — nothing at ${path}"
    fi
  done
fi

echo
echo "Done. Antigravity loads the skills at the next session start."
